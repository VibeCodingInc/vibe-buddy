{
  "productName": "Vibe Buddy",
  "version": "0.5.64",
  "identifier": "com.vibe.buddy",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Vibe Buddy",
        "width": 300,
        "height": 500,
        "minWidth": 48,
        "minHeight": 400,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: seth goldstein (595BJ5FZWJ)",
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [
        "https://www.slashvibe.dev/api/buddy-update?target={{target}}&current_version={{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOUZENEE1RTlDMDg4OTcKUldTWGlNRHBwZFNmOHFCc0h3eFcyRlpHRzJ6R0lROFRvQWYvR01GN1ZaWXFLOEd2U0hjMFRKaFYK"
    }
  }
}
